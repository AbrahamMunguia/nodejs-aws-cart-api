{
  "compilerOptions": {
    "target":      "ES2020",
    "module":      "commonjs",
    "lib":         ["es2020"],
    "declaration": true,
    "strict":      true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "outDir":      "dist",
    "rootDir":     ".",
    "experimentalDecorators": true,
    "emitDecoratorMetadata":  true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "exclude": ["node_modules", "dist"]
}
